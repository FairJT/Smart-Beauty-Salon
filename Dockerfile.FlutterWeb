
# syntax=docker/dockerfile:1.7

# ─── Build stage ────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM ghcr.io/cirruslabs/flutter:3.27.1 AS build

WORKDIR /app

# API base the app calls; /api is proxied by nginx to SalonOS
ARG API_BASE_URL=/api

# Pub/SDK mirrors — now ARGs so they're overridable per build environment.
# Defaults are the China mirror; for CI elsewhere pass
# --build-arg PUB_HOSTED_URL=https://pub.dev --build-arg FLUTTER_STORAGE_BASE_URL=https://storage.googleapis.com
ARG PUB_HOSTED_URL=https://pub.flutter-io.cn
ARG FLUTTER_STORAGE_BASE_URL=https://storage.flutter-io.cn
ENV PUB_HOSTED_URL=${PUB_HOSTED_URL} \
    FLUTTER_STORAGE_BASE_URL=${FLUTTER_STORAGE_BASE_URL}

# Resolve dependencies first for better layer caching
COPY smart_salon_app/pubspec.yaml smart_salon_app/pubspec.lock* ./
RUN --mount=type=cache,target=/root/.pub-cache flutter pub get

# App source
COPY smart_salon_app/ .

# Build. --no-web-resources-cdn bundles CanvasKit locally instead of fetching
# it from the gstatic CDN at runtime (which may be blocked → blank page).
RUN --mount=type=cache,target=/root/.pub-cache \
    flutter build web --release \
      --no-web-resources-cdn \
      --dart-define=API_BASE_URL=${API_BASE_URL}

# ─── Runtime stage ───────────────────────────────────────────
FROM nginx:1.27-alpine
# Invalidate cache so the final copy sees the fresh build output
ARG BUILD_TIMESTAMP
RUN echo $BUILD_TIMESTAMP > /dev/null

COPY --from=build /app/build/web /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1