@page
@model SmartSalon.Pages.SuperAdmin.DashboardModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Pages/Shared/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "داشبورد";
    ViewData["ActivePage"] = "Dashboard";
}

<div class="topbar">
    <div>
        <div style="font-size:1.1rem;font-weight:700;color:var(--text-primary);">داشبورد کل پلتفرم</div>
        <div style="font-size:0.8rem;color:var(--text-secondary);margin-top:2px;">
            خوش آمدید، <span style="color:var(--primary);font-weight:600;">@Model.AdminName</span>
        </div>
    </div>
    <span style="font-size:0.75rem;background:var(--primary-100);color:var(--primary);
                 padding:6px 14px;border-radius:var(--radius-full);">
        🌐 پنل پلتفرم
    </span>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="stat-lbl">کل سالن‌ها</div>
                <div class="stat-icon" style="background:var(--primary-50);">✂</div>
            </div>
            <div class="stat-num" style="color:var(--primary);">@Model.TotalSalons</div>
            <div style="font-size:0.7rem;color:var(--success);margin-top:4px;">@Model.ActiveSalons فعال</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="stat-lbl">کل کاربران</div>
                <div class="stat-icon" style="background:var(--danger-50);">👥</div>
            </div>
            <div class="stat-num">@Model.TotalUsers</div>
            <div style="font-size:0.7rem;color:var(--text-secondary);margin-top:4px;">@Model.TotalArtists هنرمند</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="stat-lbl">کل نوبت‌ها</div>
                <div class="stat-icon" style="background:var(--info-50);">📅</div>
            </div>
            <div class="stat-num">@Model.TotalAppointments</div>
            <div style="font-size:0.7rem;color:var(--primary);margin-top:4px;">@Model.TodayAppointments امروز</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card-dark">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="stat-lbl">درآمد کل</div>
                <div class="stat-icon" style="background:rgba(255,255,255,0.15);">💰</div>
            </div>
            <div class="stat-num">@Model.TotalRevenue.ToString("N0")</div>
            <div style="font-size:0.7rem;color:rgba(255,255,255,0.5);margin-top:4px;">تومان</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Latest Salons -->
    <div class="col-md-6">
        <div class="card">
            <div class="p-3 d-flex justify-content-between align-items-center"
                 style="border-bottom:1px solid var(--border-light);">
                <div class="section-header" style="margin-bottom:0;">
                    <span class="table-bar"></span>
                    <span class="section-header-label">آخرین سالن‌ها</span>
                </div>
                <a href="/SuperAdmin/Salons" style="font-size:0.75rem;color:var(--primary);">
                    مشاهده همه
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-accent mb-0">
                    <thead>
                        <tr>
                            <th>نام سالن</th>
                            <th>وضعیت</th>
                            <th>VIP</th>
                            <th>امتیاز</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.LatestSalons)
                        {
                            <tr>
                                <td style="font-weight:500;">@s.Name</td>
                                <td>
                                    <span class="badge @(s.IsActive ? "bg-success" : "bg-danger")">
                                        @(s.IsActive ? "فعال" : "غیرفعال")
                                    </span>
                                </td>
                                <td>
                                    @if (s.IsVip)
                                    {
                                        <span class="vip-badge">⭐ VIP</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--text-muted);font-size:0.75rem;">—</span>
                                    }
                                </td>
                                <td style="color:var(--text-secondary);">⭐ @s.RatingAvg.ToString("F1")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Latest Appointments -->
    <div class="col-md-6">
        <div class="card">
            <div class="p-3 d-flex justify-content-between align-items-center"
                 style="border-bottom:1px solid var(--border-light);">
                <div class="section-header" style="margin-bottom:0;">
                    <span class="table-bar"></span>
                    <span class="section-header-label">آخرین نوبت‌ها</span>
                </div>
                <a href="/SuperAdmin/Reports" style="font-size:0.75rem;color:var(--primary);">
                    گزارش کامل
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-accent mb-0">
                    <thead>
                        <tr>
                            <th>سالن</th>
                            <th>مشتری</th>
                            <th>ساعت</th>
                            <th>وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.LatestAppointments)
                        {
                            var badge = a.Status switch
                            {
                                SmartSalon.Models.AppointmentStatus.Pending => "bg-warning",
                                SmartSalon.Models.AppointmentStatus.Confirmed => "bg-success",
                                SmartSalon.Models.AppointmentStatus.Cancelled => "bg-danger",
                                _ => "bg-secondary"
                            };
                            var txt = a.Status switch
                            {
                                SmartSalon.Models.AppointmentStatus.Pending => "انتظار",
                                SmartSalon.Models.AppointmentStatus.Confirmed => "تایید",
                                SmartSalon.Models.AppointmentStatus.Cancelled => "لغو",
                                _ => "سایر"
                            };
                            <tr>
                                <td style="font-weight:500;">@a.Salon?.Name</td>
                                <td style="color:var(--text-secondary);">
                                    @a.Client?.FirstName @a.Client?.LastName
                                </td>
                                <td style="font-weight:500;">@a.StartTime.ToString("HH:mm")</td>
                                <td><span class="badge @badge">@txt</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
