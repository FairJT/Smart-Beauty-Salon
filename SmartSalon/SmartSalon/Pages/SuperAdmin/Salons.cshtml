@page
@model SmartSalon.Pages.SuperAdmin.SalonsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Pages/Shared/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "مدیریت سالن‌ها";
    ViewData["ActivePage"] = "Salons";
}

<div class="topbar d-flex justify-content-between align-items-center">
    <div>
        <div style="font-size:16px;font-weight:500;color:#0A0A1A;">مدیریت سالن‌ها</div>
        <div style="font-size:12px;color:#64748B;margin-top:2px;">@Model.Salons.Count سالن ثبت شده</div>
    </div>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addModal">
        ＋ افزودن سالن
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.Message.StartsWith("✅") ? "alert-success" : "alert-warning") mb-4">
        @Model.Message
    </div>
}

<div class="card">
    <div class="p-3" style="border-bottom:0.5px solid rgba(0,0,0,0.05);">
        <div style="display:flex;align-items:center;">
            <span class="table-bar"></span>
            <span style="font-size:14px;font-weight:500;color:#0A0A1A;">لیست سالن‌ها</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>نام سالن</th>
                    <th>Slug</th>
                    <th>تلفن</th>
                    <th>امتیاز</th>
                    <th>VIP</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Salons)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:8px;">
                                <div style="width:28px;height:28px;border-radius:50%;
                                            background:rgba(129,140,248,0.1);
                                            display:flex;align-items:center;justify-content:center;
                                            font-size:12px;color:#6366F1;font-weight:500;flex-shrink:0;">
                                    @(s.Name.Length > 0 ? s.Name[0].ToString() : "؟")
                                </div>
                                <span style="color:#0A0A1A;font-weight:500;">@s.Name</span>
                            </div>
                        </td>
                        <td style="color:#64748B;font-size:12px;">@s.Slug</td>
                        <td style="color:#64748B;">@s.Phone</td>
                        <td style="color:#F59E0B;">⭐ @s.RatingAvg.ToString("F1")</td>
                        <td>
                            <form method="post" asp-page-handler="ToggleVip"
                                  asp-route-id="@s.Id" class="d-inline">
                                <button class="btn btn-sm"
                                        style="@(s.IsVip ? "background:linear-gradient(135deg,#D4AF37,#F0C040);color:#fff;" : "background:#F8F9FA;color:#64748B;")
                                               border:none;font-size:11px;padding:3px 10px;border-radius:8px;">
                                    @(s.IsVip ? "⭐ VIP" : "VIP کن")
                                </button>
                            </form>
                        </td>
                        <td>
                            <span class="badge @(s.IsActive ? "bg-success" : "bg-danger")">
                                @(s.IsActive ? "فعال" : "غیرفعال")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <form method="post" asp-page-handler="Toggle"
                                      asp-route-id="@s.Id" class="d-inline">
                                    <button class="btn btn-sm"
                                            style="background:@(s.IsActive ? "#FEF2F2" : "#F0FDF4");
                                                   border:0.5px solid @(s.IsActive ? "#FECACA" : "#BBF7D0");
                                                   color:@(s.IsActive ? "#DC2626" : "#16A34A");
                                                   font-size:11px;">
                                        @(s.IsActive ? "غیرفعال" : "فعال")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="border-bottom:0.5px solid rgba(0,0,0,0.06);">
                <h5 class="modal-title" style="font-size:15px;">افزودن سالن جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Add">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" style="font-size:13px;color:#64748B;">نام سالن</label>
                        <input type="text" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size:13px;color:#64748B;">Slug</label>
                        <input type="text" name="Slug" class="form-control"
                               placeholder="salon-name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size:13px;color:#64748B;">
                            موبایل مدیر سالن
                        </label>
                        <input type="text" name="ManagerMobile" class="form-control"
                               placeholder="09121234567" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size:13px;color:#64748B;">آدرس</label>
                        <input type="text" name="Address" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size:13px;color:#64748B;">تلفن</label>
                        <input type="text" name="Phone" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer" style="border-top:0.5px solid rgba(0,0,0,0.06);">
                    <button type="button" class="btn btn-sm btn-secondary"
                            data-bs-dismiss="modal">
                        انصراف
                    </button>
                    <button type="submit" class="btn btn-sm btn-primary">افزودن</button>
                </div>
            </form>
        </div>
    </div>
</div>