@page
@model SmartSalon.Pages.SuperAdmin.SalonsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Pages/Shared/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "مدیریت سالن‌ها";
    ViewData["ActivePage"] = "Salons";
}

<div class="topbar d-flex justify-content-between align-items-center">
    <div>
        <div style="font-size:1.1rem;font-weight:700;color:var(--text-primary);">مدیریت سالن‌ها</div>
        <div style="font-size:0.8rem;color:var(--text-secondary);margin-top:2px;">
            @Model.Salons.Count سالن ثبت شده
        </div>
    </div>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addModal">
        ＋ افزودن سالن
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.Message.StartsWith("✅") ? "alert-success" : "alert-warning") mb-4">
        @Model.Message
    </div>
}

<div class="card">
    <div class="p-3" style="border-bottom:1px solid var(--border-light);">
        <div class="section-header" style="margin-bottom:0;">
            <span class="table-bar"></span>
            <span class="section-header-label">لیست سالن‌ها</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-accent mb-0">
            <thead>
                <tr>
                    <th>نام سالن</th>
                    <th>Slug</th>
                    <th>تلفن</th>
                    <th>امتیاز</th>
                    <th>VIP</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Salons)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:8px;">
                                <div style="width:28px;height:28px;border-radius:50%;
                                            background:var(--primary-100);
                                            display:flex;align-items:center;justify-content:center;
                                            font-size:12px;color:var(--primary);font-weight:600;flex-shrink:0;">
                                    @(s.Name.Length > 0 ? s.Name[0].ToString() : "؟")
                                </div>
                                <span style="font-weight:500;">@s.Name</span>
                            </div>
                        </td>
                        <td style="color:var(--text-secondary);font-size:0.75rem;">@s.Slug</td>
                        <td style="color:var(--text-secondary);">@s.Phone</td>
                        <td style="color:#F59E0B;font-weight:600;">⭐ @s.RatingAvg.ToString("F1")</td>
                        <td>
                            <form method="post" asp-page-handler="ToggleVip"
                                  asp-route-id="@s.Id" class="d-inline">
                                <button class="btn-action"
                                        style="@(s.IsVip ? "background:linear-gradient(135deg,#D4AF37,#F0C040);color:#fff;border-color:transparent;" : "background:#F3F4F6;color:#6B7280;border-color:#E5E7EB;")">
                                    @(s.IsVip ? "⭐ VIP" : "VIP کن")
                                </button>
                            </form>
                        </td>
                        <td>
                            <span class="badge @(s.IsActive ? "bg-success" : "bg-danger")">
                                @(s.IsActive ? "فعال" : "غیرفعال")
                            </span>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Toggle"
                                  asp-route-id="@s.Id" class="d-inline">
                                <button class="btn-action"
                                        style="@(s.IsActive ? "background:var(--danger-50);border-color:rgba(239,68,68,0.2);color:#DC2626;" : "background:var(--success-50);border-color:rgba(16,185,129,0.2);color:#059669;")">
                                    @(s.IsActive ? "غیرفعال" : "فعال")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Salon Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">افزودن سالن جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Add">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">نام سالن</label>
                        <input type="text" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Slug</label>
                        <input type="text" name="Slug" class="form-control"
                               placeholder="salon-name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">موبایل مدیر سالن</label>
                        <input type="text" name="ManagerMobile" class="form-control"
                               placeholder="09121234567" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">آدرس</label>
                        <input type="text" name="Address" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تلفن</label>
                        <input type="text" name="Phone" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm"
                            data-bs-dismiss="modal">
                        انصراف
                    </button>
                    <button type="submit" class="btn btn-primary btn-sm">افزودن</button>
                </div>
            </form>
        </div>
    </div>
</div>
