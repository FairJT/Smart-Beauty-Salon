@page
@model SmartSalon.Pages.SuperAdmin.SubscriptionsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Pages/Shared/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "اشتراک‌ها";
    ViewData["ActivePage"] = "Subscriptions";
}

<div class="topbar d-flex justify-content-between align-items-center">
    <div>
        <div style="font-size:16px;font-weight:500;color:#0A0A1A;">مدیریت اشتراک‌ها</div>
        <div style="font-size:12px;color:#64748B;margin-top:2px;">پلن‌های سالن‌ها</div>
    </div>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addModal">
        ＋ افزودن اشتراک
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.Message.StartsWith("✅") ? "alert-success" : "alert-warning") mb-4">
        @Model.Message
    </div>
}

<!-- پلن‌ها -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-4 text-center">
            <div style="font-size:28px;margin-bottom:8px;">🥉</div>
            <div style="font-size:15px;font-weight:500;color:#0A0A1A;margin-bottom:4px;">پایه</div>
            <div style="font-size:24px;font-weight:500;color:#64748B;margin-bottom:12px;">رایگان</div>
            <div style="font-size:11px;color:#64748B;text-align:right;">
                <div class="mb-1">✅ تا ۲ هنرمند</div>
                <div class="mb-1">✅ تا ۵۰ نوبت در ماه</div>
                <div class="mb-1">❌ بدون SMS</div>
                <div>❌ بدون آمار پیشرفته</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 text-center"
             style="border:0.5px solid rgba(129,140,248,0.4);">
            <div style="font-size:28px;margin-bottom:8px;">🥈</div>
            <div style="font-size:15px;font-weight:500;color:#0A0A1A;margin-bottom:4px;">حرفه‌ای</div>
            <div style="font-size:24px;font-weight:500;color:#6366F1;margin-bottom:12px;">
                ۲۹۰,۰۰۰
                <span style="font-size:12px;color:#64748B;">تومان/ماه</span>
            </div>
            <div style="font-size:11px;color:#64748B;text-align:right;">
                <div class="mb-1">✅ تا ۱۰ هنرمند</div>
                <div class="mb-1">✅ نوبت نامحدود</div>
                <div class="mb-1">✅ SMS یادآوری</div>
                <div>❌ بدون آمار پیشرفته</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 text-center"
             style="border:0.5px solid rgba(212,175,55,0.4);">
            <div style="font-size:28px;margin-bottom:8px;">🥇</div>
            <div style="font-size:15px;font-weight:500;color:#0A0A1A;margin-bottom:4px;">VIP</div>
            <div style="font-size:24px;font-weight:500;color:#D4AF37;margin-bottom:12px;">
                ۵۹۰,۰۰۰
                <span style="font-size:12px;color:#64748B;">تومان/ماه</span>
            </div>
            <div style="font-size:11px;color:#64748B;text-align:right;">
                <div class="mb-1">✅ هنرمند نامحدود</div>
                <div class="mb-1">✅ نوبت نامحدود</div>
                <div class="mb-1">✅ SMS یادآوری</div>
                <div>✅ آمار پیشرفته</div>
            </div>
        </div>
    </div>
</div>

<!-- لیست اشتراک‌ها -->
<div class="card">
    <div class="p-3" style="border-bottom:0.5px solid rgba(0,0,0,0.05);">
        <div style="display:flex;align-items:center;">
            <span class="table-bar"></span>
            <span style="font-size:14px;font-weight:500;color:#0A0A1A;">اشتراک‌های فعال</span>
        </div>
    </div>
    @if (!Model.Subscriptions.Any())
    {
        <div class="text-center py-5" style="color:#64748B;">
            <div style="font-size:40px;margin-bottom:8px;">💳</div>
            <div>هنوز اشتراکی ثبت نشده</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>سالن</th>
                        <th>پلن</th>
                        <th>شروع</th>
                        <th>پایان</th>
                        <th>مبلغ</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Subscriptions)
                    {
                        <tr>
                            <td style="color:#0A0A1A;font-weight:500;">@s.SalonName</td>
                            <td>
                                <span style="@(s.Plan == "VIP" ? "background:linear-gradient(135deg,#D4AF37,#F0C040);color:#fff;" :
                                              s.Plan == "Pro" ? "background:rgba(129,140,248,0.12);color:#6366F1;" :
                                              "background:#F1F5F9;color:#64748B;")
                                             font-size:11px;padding:2px 10px;border-radius:10px;">
                                    @s.Plan
                                </span>
                            </td>
                            <td style="color:#64748B;font-size:12px;">
                                @s.StartDate.ToString("yyyy/MM/dd")
                            </td>
                            <td style="color:#64748B;font-size:12px;">
                                @s.EndDate.ToString("yyyy/MM/dd")
                            </td>
                            <td style="color:#0A0A1A;font-weight:500;">
                                @s.Amount.ToString("N0")
                            </td>
                            <td>
                                <span class="badge @(s.IsActive ? "bg-success" : "bg-danger")">
                                    @(s.IsActive ? "فعال" : "منقضی")
                                </span>
                            </td>
                            <td>
                                <form method="post" asp-page-handler="Extend"
                                      asp-route-id="@s.Id" class="d-inline">
                                    <button class="btn btn-sm"
                                            style="background:rgba(129,140,248,0.1);
                                                   border:0.5px solid rgba(129,140,248,0.3);
                                                   color:#6366F1;font-size:11px;">
                                        تمدید
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="border-bottom:0.5px solid rgba(0,0,0,0.06);">
                <h5 class="modal-title" style="font-size:15px;">افزودن اشتراک</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Add">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" style="font-size:13px;color:#64748B;">سالن</label>
                        <select name="SalonId" class="form-select">
                            @foreach (var salon in Model.Salons)
                            {
                                <option value="@salon.Id">@salon.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size:13px;color:#64748B;">پلن</label>
                        <select name="Plan" class="form-select">
                            <option value="Basic">🥉 پایه — رایگان</option>
                            <option value="Pro">🥈 حرفه‌ای — ۲۹۰,۰۰۰ تومان</option>
                            <option value="VIP">🥇 VIP — ۵۹۰,۰۰۰ تومان</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size:13px;color:#64748B;">
                            مدت (ماه)
                        </label>
                        <input type="number" name="Months" class="form-control"
                               value="1" min="1" max="12" />
                    </div>
                </div>
                <div class="modal-footer" style="border-top:0.5px solid rgba(0,0,0,0.06);">
                    <button type="button" class="btn btn-sm btn-secondary"
                            data-bs-dismiss="modal">
                        انصراف
                    </button>
                    <button type="submit" class="btn btn-sm btn-primary">ثبت اشتراک</button>
                </div>
            </form>
        </div>
    </div>
</div>