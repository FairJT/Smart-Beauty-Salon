@page
@model SmartSalon.Pages.SuperAdmin.ReportsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Pages/Shared/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "گزارش‌های مالی";
    ViewData["ActivePage"] = "Reports";
}

<div class="topbar d-flex justify-content-between align-items-center">
    <div>
        <div style="font-size:16px;font-weight:500;color:#0A0A1A;">گزارش‌های مالی</div>
        <div style="font-size:12px;color:#64748B;margin-top:2px;">
            @Model.From تا @Model.To
        </div>
    </div>
    <form method="get" class="d-flex gap-2 align-items-center">
        <label style="font-size:12px;color:#64748B;">از:</label>
        <input type="date" name="from" value="@Model.From"
               class="form-control form-control-sm" style="width:140px;" />
        <label style="font-size:12px;color:#64748B;">تا:</label>
        <input type="date" name="to" value="@Model.To"
               class="form-control form-control-sm" style="width:140px;" />
        <button type="submit" class="btn btn-primary btn-sm">فیلتر</button>
    </form>
</div>

<!-- آمار -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-lbl">کل نوبت‌ها</div>
            <div class="stat-num">@Model.TotalAppointments</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-lbl">تایید شده</div>
            <div class="stat-num" style="color:#16A34A;">@Model.ConfirmedAppointments</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-lbl">لغو شده</div>
            <div class="stat-num" style="color:#DC2626;">@Model.CancelledAppointments</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card-dark">
            <div class="stat-lbl">درآمد کل</div>
            <div class="stat-num">@Model.TotalRevenue.ToString("N0")</div>
            <div style="font-size:11px;color:rgba(255,255,255,0.3);margin-top:4px;">تومان</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- گزارش سالن‌ها -->
    <div class="col-md-7">
        <div class="card">
            <div class="p-3" style="border-bottom:0.5px solid rgba(0,0,0,0.05);">
                <div style="display:flex;align-items:center;">
                    <span class="table-bar"></span>
                    <span style="font-size:14px;font-weight:500;color:#0A0A1A;">
                        درآمد به تفکیک سالن
                    </span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>سالن</th>
                            <th>کل</th>
                            <th>تایید</th>
                            <th>لغو</th>
                            <th>درآمد</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.SalonReports)
                        {
                            <tr>
                                <td style="color:#0A0A1A;font-weight:500;">@r.SalonName</td>
                                <td style="color:#64748B;">@r.Total</td>
                                <td style="color:#16A34A;">@r.Confirmed</td>
                                <td style="color:#DC2626;">@r.Cancelled</td>
                                <td style="color:#0A0A1A;font-weight:500;">
                                    @r.Revenue.ToString("N0")
                                </td>
                            </tr>
                        }
                        <tr style="background:#FAFAFA;font-weight:500;">
                            <td style="color:#0A0A1A;">جمع کل</td>
                            <td style="color:#64748B;">@Model.TotalAppointments</td>
                            <td style="color:#16A34A;">@Model.ConfirmedAppointments</td>
                            <td style="color:#DC2626;">@Model.CancelledAppointments</td>
                            <td style="color:#6366F1;">@Model.TotalRevenue.ToString("N0")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- گزارش روزانه -->
    <div class="col-md-5">
        <div class="card">
            <div class="p-3" style="border-bottom:0.5px solid rgba(0,0,0,0.05);">
                <div style="display:flex;align-items:center;">
                    <span class="table-bar"></span>
                    <span style="font-size:14px;font-weight:500;color:#0A0A1A;">گزارش روزانه</span>
                </div>
            </div>
            <div class="table-responsive" style="max-height:350px;overflow-y:auto;">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>تاریخ</th>
                            <th>تعداد</th>
                            <th>درآمد</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.DailyReports)
                        {
                            <tr>
                                <td style="color:#64748B;font-size:12px;">@d.Date</td>
                                <td style="color:#0A0A1A;">@d.Count</td>
                                <td style="color:#0A0A1A;font-weight:500;">
                                    @d.Revenue.ToString("N0")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>