<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | پنل مدیر پلتفرم</title>
    <link href="~/lib/bootstrap/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
    <style>
        /* ── SuperAdmin Sidebar ──────────────────────────────── */
        .sidebar {
            background: linear-gradient(180deg, #0F0A1A 0%, #1A0F2E 100%);
            min-height: 100vh;
            position: fixed;
            width: 240px;
            right: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            border-left: 1px solid rgba(255,255,255,0.06);
            z-index: 100;
        }

        .sidebar-logo {
            padding: 24px 20px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #818CF8, #6366F1);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .logo-name {
            color: #A5B4FC;
            font-size: 14px;
            font-weight: 700;
            font-family: var(--font-family);
        }

        .logo-sub {
            color: rgba(255,255,255,0.3);
            font-size: 9px;
            letter-spacing: 2px;
            font-weight: 600;
        }

        .sidebar-nav {
            padding: 16px 12px;
            flex: 1;
        }

        .nav-section-label {
            font-size: 9px;
            color: rgba(255,255,255,0.25);
            padding: 0 8px;
            margin-bottom: 10px;
            letter-spacing: 2px;
            font-weight: 600;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: var(--radius-sm);
            margin-bottom: 2px;
            text-decoration: none;
            color: rgba(255,255,255,0.4);
            font-size: 13px;
            font-family: var(--font-family);
            font-weight: 500;
            transition: all var(--transition-fast);
            border: 1px solid transparent;
        }

        .sidebar a:hover {
            background: rgba(129,140,248,0.08);
            color: #A5B4FC;
        }

        .sidebar a.active {
            background: rgba(129,140,248,0.12);
            color: #A5B4FC;
            border-color: rgba(129,140,248,0.2);
            font-weight: 600;
        }

        .sidebar a.active .dot {
            display: block;
        }

        .sidebar a .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #818CF8;
            margin-right: auto;
            display: none;
        }

        .nav-divider {
            height: 1px;
            background: rgba(255,255,255,0.06);
            margin: 12px 4px;
        }

        .sidebar-user {
            padding: 12px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .user-inner {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: var(--radius-md);
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.04);
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #818CF8, #6366F1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: #fff;
            font-weight: 700;
            flex-shrink: 0;
        }

        .user-name {
            color: #fff;
            font-size: 12px;
            font-weight: 600;
        }

        .user-role {
            color: rgba(255,255,255,0.3);
            font-size: 10px;
        }

        .main-content {
            margin-right: 240px;
            padding: 24px;
            min-height: 100vh;
        }

        .vip-badge {
            background: linear-gradient(135deg, #D4AF37, #F0C040);
            color: #fff;
            padding: 2px 10px;
            border-radius: var(--radius-full);
            font-size: 0.65rem;
            font-weight: 600;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">🌐</div>
            <div>
                <div class="logo-name">SmartSalon</div>
                <div class="logo-sub">SUPER ADMIN</div>
            </div>
        </div>

        <div class="sidebar-nav">
            <div class="nav-section-label">منو اصلی</div>

            <a href="/SuperAdmin/Dashboard"
               class="@(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
                📊 داشبورد پلتفرم
                <span class="dot"></span>
            </a>
            <a href="/SuperAdmin/Salons"
               class="@(ViewData["ActivePage"]?.ToString() == "Salons" ? "active" : "")">
                ✂ مدیریت سالن‌ها
                <span class="dot"></span>
            </a>
            <a href="/SuperAdmin/Users"
               class="@(ViewData["ActivePage"]?.ToString() == "Users" ? "active" : "")">
                👥 مدیریت کاربران
                <span class="dot"></span>
            </a>
            <a href="/SuperAdmin/Subscriptions"
               class="@(ViewData["ActivePage"]?.ToString() == "Subscriptions" ? "active" : "")">
                💳 اشتراک‌ها
                <span class="dot"></span>
            </a>
            <a href="/SuperAdmin/Reports"
               class="@(ViewData["ActivePage"]?.ToString() == "Reports" ? "active" : "")">
                📈 گزارش‌های مالی
                <span class="dot"></span>
            </a>
        </div>

        <div class="sidebar-user">
            <div class="user-inner">
                <div class="user-avatar">س</div>
                <div style="flex:1;min-width:0;">
                    <div class="user-name">سوپر ادمین</div>
                    <div class="user-role">مدیر پلتفرم</div>
                </div>
                <a href="/SuperAdmin/Login"
                   style="color:rgba(255,255,255,0.25);text-decoration:none;font-size:14px;"
                   title="خروج">🚪</a>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="main-content">
        @RenderBody()
    </div>

    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
