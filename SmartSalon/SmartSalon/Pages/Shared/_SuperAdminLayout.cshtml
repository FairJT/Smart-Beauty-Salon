<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | پنل مدیر پلتفرم</title>
    <link href="~/lib/bootstrap/bootstrap.rtl.min.css" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            background: #F0F4FF;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, sans-serif;
        }

        .sidebar {
            background: #0A0A1A;
            min-height: 100vh;
            position: fixed;
            width: 230px;
            right: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            border-left: 0.5px solid rgba(255,255,255,0.06);
            z-index: 100;
        }

        .sidebar-logo {
            padding: 20px 16px 16px;
            border-bottom: 0.5px solid rgba(255,255,255,0.06);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #818CF8, #6366F1);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            flex-shrink: 0;
        }

        .logo-name {
            color: #818CF8;
            font-size: 13px;
            font-weight: 600;
        }

        .logo-sub {
            color: rgba(255,255,255,0.2);
            font-size: 9px;
            letter-spacing: 1px;
        }

        .sidebar-nav {
            padding: 14px 10px;
            flex: 1;
        }

        .nav-section-label {
            font-size: 9px;
            color: rgba(255,255,255,0.2);
            padding: 0 6px;
            margin-bottom: 8px;
            letter-spacing: 2px;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            border-radius: 9px;
            margin-bottom: 2px;
            text-decoration: none;
            color: rgba(255,255,255,0.35);
            font-size: 13px;
            transition: all 0.2s;
        }

            .sidebar a:hover {
                background: rgba(129,140,248,0.1);
                color: #818CF8;
            }

            .sidebar a.active {
                background: rgba(129,140,248,0.12);
                color: #818CF8;
                border: 0.5px solid rgba(129,140,248,0.3);
            }

            .sidebar a .dot {
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: #818CF8;
                margin-right: auto;
                display: none;
            }

            .sidebar a.active .dot {
                display: block;
            }

        .nav-divider {
            height: 0.5px;
            background: rgba(255,255,255,0.06);
            margin: 10px 4px;
        }

        .sidebar-user {
            padding: 12px 10px;
            border-top: 0.5px solid rgba(255,255,255,0.06);
        }

        .user-inner {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 12px;
            border-radius: 10px;
            background: rgba(255,255,255,0.04);
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #818CF8, #6366F1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: #fff;
            font-weight: 600;
            flex-shrink: 0;
        }

        .user-name {
            color: #fff;
            font-size: 12px;
            font-weight: 500;
        }

        .user-role {
            color: rgba(255,255,255,0.3);
            font-size: 10px;
        }

        .main-content {
            margin-right: 230px;
            padding: 24px;
            min-height: 100vh;
        }

        .topbar {
            background: #fff;
            padding: 14px 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            border: 0.5px solid rgba(0,0,0,0.06);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card {
            border-radius: 14px;
            border: 0.5px solid rgba(0,0,0,0.06);
            box-shadow: none;
            background: #fff;
        }

        .stat-card {
            background: #fff;
            border-radius: 14px;
            padding: 18px;
            border: 0.5px solid rgba(0,0,0,0.06);
        }

        .stat-card-dark {
            background: #0A0A1A;
            border-radius: 14px;
            padding: 18px;
        }

        .stat-num {
            font-size: 28px;
            font-weight: 500;
            color: #0A0A1A;
        }

        .stat-lbl {
            font-size: 11px;
            color: #64748B;
            margin-bottom: 10px;
        }

        .stat-card-dark .stat-num {
            color: #818CF8;
        }

        .stat-card-dark .stat-lbl {
            color: rgba(255,255,255,0.4);
        }

        .table-bar {
            width: 3px;
            height: 16px;
            background: #6366F1;
            border-radius: 2px;
            display: inline-block;
            margin-left: 8px;
            vertical-align: middle;
        }

        .btn-primary {
            background: #6366F1 !important;
            border-color: #6366F1 !important;
        }

        .badge.bg-success {
            background: #F0FDF4 !important;
            color: #16A34A !important;
        }

        .badge.bg-danger {
            background: #FEF2F2 !important;
            color: #DC2626 !important;
        }

        .badge.bg-warning {
            background: #FFF8E8 !important;
            color: #B07D2A !important;
        }

        .badge.bg-primary {
            background: rgba(129,140,248,0.12) !important;
            color: #6366F1 !important;
        }

        .badge.bg-secondary {
            background: #F1F5F9 !important;
            color: #64748B !important;
        }

        .badge.bg-info {
            background: #EFF6FF !important;
            color: #2563EB !important;
        }

        thead th {
            background: #FAFAFA;
            color: #64748B;
            font-weight: 400;
            font-size: 12px;
            border-bottom: 0.5px solid rgba(0,0,0,0.06) !important;
        }

        td {
            font-size: 13px;
            border-color: rgba(0,0,0,0.04) !important;
        }

        .vip-badge {
            background: linear-gradient(135deg, #D4AF37, #F0C040);
            color: #fff;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 500;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- سایدبار -->
    <div class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">🌐</div>
            <div>
                <div class="logo-name">SmartSalon</div>
                <div class="logo-sub">SUPER ADMIN</div>
            </div>
        </div>

        <div class="sidebar-nav">
            <div class="nav-section-label">منو اصلی</div>

            <a href="/SuperAdmin/Dashboard"
               class="@(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
                📊 داشبورد پلتفرم
                <span class="dot"></span>
            </a>
            <a href="/SuperAdmin/Salons"
               class="@(ViewData["ActivePage"]?.ToString() == "Salons" ? "active" : "")">
                ✂ مدیریت سالن‌ها
                <span class="dot"></span>
            </a>
            <a href="/SuperAdmin/Users"
               class="@(ViewData["ActivePage"]?.ToString() == "Users" ? "active" : "")">
                👥 مدیریت کاربران
                <span class="dot"></span>
            </a>
            <a href="/SuperAdmin/Subscriptions"
               class="@(ViewData["ActivePage"]?.ToString() == "Subscriptions" ? "active" : "")">
                💳 اشتراک‌ها
                <span class="dot"></span>
            </a>
            <a href="/SuperAdmin/Reports"
               class="@(ViewData["ActivePage"]?.ToString() == "Reports" ? "active" : "")">
                📈 گزارش‌های مالی
                <span class="dot"></span>
            </a>
        </div>

        <div class="sidebar-user">
            <div class="user-inner">
                <div class="user-avatar">س</div>
                <div style="flex:1;min-width:0;">
                    <div class="user-name">سوپر ادمین</div>
                    <div class="user-role">مدیر پلتفرم</div>
                </div>
                <a href="/SuperAdmin/Login"
                   style="color:rgba(255,255,255,0.2);text-decoration:none;font-size:14px;">🚪</a>
            </div>
        </div>
    </div>

    <!-- محتوا -->
    <div class="main-content">
        @RenderBody()
    </div>

    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>