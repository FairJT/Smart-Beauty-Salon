@using SmartSalon.Data
@inject ApplicationDbContext _db
@{
    var adminToken = Context.Session.GetString("AdminToken");
    var salon = adminToken != null
        ? _db.Salons.FirstOrDefault(s => s.ManagerId == adminToken)
        : null;
    var theme = salon?.AdminTheme ?? "gold";
    var adminName = Context.Session.GetString("AdminName") ?? "مدیر";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | سالن هوشمند</title>
    <link href="~/lib/bootstrap/bootstrap.rtl.min.css" rel="stylesheet">
    <style>
        /* ══════════════════════════════════════
                   تم‌های رنگی
                ══════════════════════════════════════ */
        .t-gold {
            --sb: #0A0A0A;
            --sb2: #D4AF37;
            --sb3: rgba(212,175,55,0.12);
            --sb4: rgba(212,175,55,0.3);
            --mg: #F9F8F4;
            --acc: #D4AF37;
            --txt: #0A0A0A;
            --ctxt: #7A6A40;
        }

        .t-blue {
            --sb: #060E1A;
            --sb2: #60A5FA;
            --sb3: rgba(96,165,250,0.1);
            --sb4: rgba(96,165,250,0.25);
            --mg: #EFF6FF;
            --acc: #1D4ED8;
            --txt: #0A1628;
            --ctxt: #3B6090;
        }

        .t-purple {
            --sb: #0F0518;
            --sb2: #C084FC;
            --sb3: rgba(192,132,252,0.1);
            --sb4: rgba(192,132,252,0.25);
            --mg: #FAF5FF;
            --acc: #7C3AED;
            --txt: #1A0A2E;
            --ctxt: #6B3FA0;
        }

        .t-teal {
            --sb: #061212;
            --sb2: #2DD4BF;
            --sb3: rgba(45,212,191,0.08);
            --sb4: rgba(45,212,191,0.2);
            --mg: #F0FDFB;
            --acc: #0D9488;
            --txt: #0A1F1E;
            --ctxt: #2A8A80;
        }

        .t-crimson {
            --sb: #0A0404;
            --sb2: #F87171;
            --sb3: rgba(248,113,113,0.1);
            --sb4: rgba(248,113,113,0.2);
            --mg: #FFF5F5;
            --acc: #B91C1C;
            --txt: #1A0808;
            --ctxt: #8A3A3A;
        }

        .t-amber {
            --sb: #0C0A09;
            --sb2: #FCD34D;
            --sb3: rgba(252,211,77,0.08);
            --sb4: rgba(252,211,77,0.2);
            --mg: #FFFBEB;
            --acc: #D97706;
            --txt: #1C1917;
            --ctxt: #926B20;
        }

        .t-slate {
            --sb: #F8FAFC;
            --sb2: #334155;
            --sb3: #334155;
            --sb4: rgba(51,65,85,0.15);
            --mg: #fff;
            --acc: #334155;
            --txt: #0F172A;
            --ctxt: #64748B;
        }

        .t-coral {
            --sb: #120604;
            --sb2: #FB923C;
            --sb3: rgba(251,146,60,0.1);
            --sb4: rgba(251,146,60,0.2);
            --mg: #FFF7ED;
            --acc: #EA580C;
            --txt: #1F0A08;
            --ctxt: #8A4020;
        }

        /* ══════════════════════════════════════
                   پایه
                ══════════════════════════════════════ */
        * {
            box-sizing: border-box;
        }

        body {
            background: var(--mg);
            margin: 0;
            font-family: 'Segoe UI', Tahoma, sans-serif;
            transition: background 0.3s;
        }

        /* ══════════════════════════════════════
                   سایدبار
                ══════════════════════════════════════ */
        .sidebar {
            background: var(--sb);
            min-height: 100vh;
            position: fixed;
            width: 230px;
            right: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            border-left: 0.5px solid rgba(255,255,255,0.06);
            transition: background 0.3s;
            z-index: 100;
        }

        .t-slate .sidebar {
            border-left-color: rgba(0,0,0,0.08);
        }

        .sidebar-logo {
            padding: 20px 16px 16px;
            border-bottom: 0.5px solid rgba(255,255,255,0.06);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .t-slate .sidebar-logo {
            border-bottom-color: rgba(0,0,0,0.08);
        }

        .logo-icon {
            width: 36px;
            height: 36px;
            background: var(--sb2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            flex-shrink: 0;
            color: var(--sb);
        }

        .t-slate .logo-icon {
            color: #fff;
        }

        .logo-name {
            color: var(--sb2);
            font-size: 13px;
            font-weight: 600;
            transition: color 0.3s;
        }

        .logo-sub {
            color: rgba(255,255,255,0.2);
            font-size: 9px;
            letter-spacing: 1px;
        }

        .t-slate .logo-sub {
            color: rgba(0,0,0,0.3);
        }

        /* منو */
        .sidebar-nav {
            padding: 14px 10px;
            flex: 1;
        }

        .nav-section-label {
            font-size: 9px;
            color: rgba(255,255,255,0.2);
            padding: 0 6px;
            margin-bottom: 8px;
            letter-spacing: 2px;
        }

        .t-slate .nav-section-label {
            color: rgba(0,0,0,0.3);
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            border-radius: 9px;
            margin-bottom: 2px;
            text-decoration: none;
            color: rgba(255,255,255,0.35);
            font-size: 13px;
            transition: all 0.2s;
        }

        .t-slate .sidebar a {
            color: rgba(51,65,85,0.5);
        }

        .sidebar a:hover {
            background: var(--sb3);
            color: var(--sb2);
        }

        .sidebar a.active {
            background: var(--sb3);
            color: var(--sb2);
            border: 0.5px solid var(--sb4);
        }

        .sidebar a .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--sb2);
            margin-right: auto;
            display: none;
        }

        .sidebar a.active .dot {
            display: block;
        }

        .nav-badge {
            font-size: 10px;
            background: var(--sb3);
            color: var(--sb2);
            padding: 1px 7px;
            border-radius: 10px;
            border: 0.5px solid var(--sb4);
            margin-right: auto;
        }

        .nav-divider {
            height: 0.5px;
            background: rgba(255,255,255,0.06);
            margin: 10px 4px;
        }

        .t-slate .nav-divider {
            background: rgba(0,0,0,0.08);
        }

        /* کاربر پایین سایدبار */
        .sidebar-user {
            padding: 12px 10px;
            border-top: 0.5px solid rgba(255,255,255,0.06);
        }

        .t-slate .sidebar-user {
            border-top-color: rgba(0,0,0,0.08);
        }

        .user-inner {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 12px;
            border-radius: 10px;
            background: rgba(255,255,255,0.04);
        }

        .t-slate .user-inner {
            background: rgba(0,0,0,0.04);
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--sb2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: var(--sb);
            font-weight: 600;
            flex-shrink: 0;
        }

        .t-slate .user-avatar {
            color: #fff;
        }

        .user-name {
            color: #fff;
            font-size: 12px;
            font-weight: 500;
        }

        .t-slate .user-name {
            color: #0F172A;
        }

        .user-role {
            color: rgba(255,255,255,0.3);
            font-size: 10px;
        }

        .t-slate .user-role {
            color: rgba(0,0,0,0.4);
        }

        /* ══════════════════════════════════════
                   محتوا
                ══════════════════════════════════════ */
        .main-content {
            margin-right: 230px;
            padding: 24px;
            min-height: 100vh;
            background: var(--mg);
            transition: background 0.3s;
        }

        /* topbar */
        .topbar {
            background: #fff;
            padding: 14px 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            border: 0.5px solid rgba(0,0,0,0.06);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* کارت‌ها */
        .card {
            border-radius: 14px;
            border: 0.5px solid rgba(0,0,0,0.06);
            box-shadow: none;
        }

        /* دکمه‌ها */
        .btn-primary {
            background: var(--acc) !important;
            border-color: var(--acc) !important;
            color: #fff !important;
        }

            .btn-primary:hover {
                opacity: 0.9;
            }

        /* badge وضعیت */
        .badge.bg-warning {
            background: #FFF8E8 !important;
            color: #B07D2A !important;
        }

        .badge.bg-success {
            background: #F0FDF4 !important;
            color: #16A34A !important;
        }

        .badge.bg-danger {
            background: #FEF2F2 !important;
            color: #DC2626 !important;
        }

        .badge.bg-primary {
            background: var(--sb3) !important;
            color: var(--sb2) !important;
        }

        .badge.bg-secondary {
            background: #F1F5F9 !important;
            color: #64748B !important;
        }

        /* stat cards */
        .stat-card {
            background: #fff;
            border-radius: 14px;
            padding: 18px;
            border: 0.5px solid rgba(0,0,0,0.06);
        }

        .stat-card-dark {
            background: var(--sb);
            border-radius: 14px;
            padding: 18px;
        }

            .stat-card-dark .stat-num {
                color: var(--sb2);
            }

            .stat-card-dark .stat-lbl {
                color: rgba(255,255,255,0.4);
            }

        .stat-num {
            font-size: 28px;
            font-weight: 500;
            color: var(--txt);
        }

        .stat-lbl {
            font-size: 11px;
            color: var(--ctxt);
            margin-bottom: 10px;
        }

        .stat-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        /* جدول */
        .table-accent thead th {
            background: var(--mg);
            color: var(--ctxt);
            font-weight: 400;
            font-size: 12px;
            border-bottom: 0.5px solid rgba(0,0,0,0.06);
        }

        .table-accent td {
            color: var(--txt);
            font-size: 13px;
            border-color: rgba(0,0,0,0.04);
        }

        .table-bar {
            width: 3px;
            height: 16px;
            background: var(--acc);
            border-radius: 2px;
            display: inline-block;
            margin-left: 8px;
            vertical-align: middle;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="t-@theme">

    <!-- ─── سایدبار ─────────────────────────── -->
    <div class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">✂</div>
            <div>
                <div class="logo-name">سالن هوشمند</div>
                <div class="logo-sub">SMART SALON</div>
            </div>
        </div>

        <div class="sidebar-nav">
            <div class="nav-section-label">منو اصلی</div>

            <a href="/Admin/Dashboard"
               class="@(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
                📊 داشبورد
                <span class="dot"></span>
            </a>

            <a href="/Admin/Appointments"
               class="@(ViewData["ActivePage"]?.ToString() == "Appointments" ? "active" : "")">
                📅 نوبت‌ها
                <span class="dot"></span>
            </a>

            <a href="/Admin/Artists"
               class="@(ViewData["ActivePage"]?.ToString() == "Artists" ? "active" : "")">
                👤 پرسنل
                <span class="dot"></span>
            </a>

            <a href="/Admin/Services"
               class="@(ViewData["ActivePage"]?.ToString() == "Services" ? "active" : "")">
                💅 خدمات
                <span class="dot"></span>
            </a>

            <a href="/Admin/Packages"
               class="@(ViewData["ActivePage"]?.ToString() == "Packages" ? "active" : "")">
                📦 پکیج‌ها
                <span class="dot"></span>
            </a>

            <div class="nav-divider"></div>

            <a href="/Admin/Settings"
               class="@(ViewData["ActivePage"]?.ToString() == "Settings" ? "active" : "")">
                ⚙️ تنظیمات
                <span class="dot"></span>
            </a>
        </div>

        <div class="sidebar-user">
            <div class="user-inner">
                <div class="user-avatar">
                    @(adminName.Length > 0 ? adminName[0].ToString() : "م")
                </div>
                <div style="flex:1;min-width:0;">
                    <div class="user-name">@adminName</div>
                    <div class="user-role">مدیر سالن</div>
                </div>
                <a href="/Admin/Login" style="color:rgba(255,255,255,0.2);text-decoration:none;font-size:14px;">🚪</a>
            </div>
        </div>
    </div>

    <!-- ─── محتوای اصلی ──────────────────────── -->
    <div class="main-content">
        @RenderBody()
    </div>

    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>