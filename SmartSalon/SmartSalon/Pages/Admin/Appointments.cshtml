@page
@model SmartSalon.Pages.Admin.AppointmentsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "نوبت‌ها";
    ViewData["ActivePage"] = "Appointments";
}

<!-- topbar -->
<div class="topbar">
    <div>
        <div style="font-size:16px;font-weight:500;color:var(--txt);">مدیریت نوبت‌ها</div>
        <div style="font-size:12px;color:var(--ctxt);margin-top:2px;">
            تاریخ انتخابی: @Model.SelectedDate.ToString("yyyy/MM/dd")
        </div>
    </div>
    <form method="get" class="d-flex gap-2 align-items-center">
        <input type="date" name="date"
               value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
               class="form-control form-control-sm"
               style="width:160px;" />
        <button type="submit" class="btn btn-primary btn-sm">فیلتر</button>
    </form>
</div>

<!-- کارت‌های آمار روز -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-lbl">کل نوبت‌ها</div>
            <div class="stat-num">@Model.Appointments.Count</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-lbl">در انتظار</div>
            <div class="stat-num" style="color:#B07D2A;">
                @Model.Appointments.Count(a => a.Status == SmartSalon.Models.AppointmentStatus.Pending)
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-lbl">تایید شده</div>
            <div class="stat-num" style="color:#16A34A;">
                @Model.Appointments.Count(a => a.Status == SmartSalon.Models.AppointmentStatus.Confirmed)
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card-dark">
            <div class="stat-lbl">درآمد روز</div>
            <div class="stat-num">@Model.TodayRevenue.ToString("N0")</div>
            <div style="font-size:11px;color:rgba(255,255,255,0.3);margin-top:4px;">تومان</div>
        </div>
    </div>
</div>

<!-- جدول نوبت‌ها -->
<div class="card">
    <div class="p-3 d-flex justify-content-between align-items-center"
         style="border-bottom:0.5px solid rgba(0,0,0,0.05);">
        <div style="display:flex;align-items:center;">
            <span class="table-bar"></span>
            <span style="font-size:14px;font-weight:500;color:var(--txt);">لیست نوبت‌ها</span>
        </div>
        <span style="font-size:11px;background:var(--sb3);color:var(--sb2);
                     padding:3px 10px;border-radius:20px;border:0.5px solid var(--sb4);">
            @Model.Appointments.Count نوبت
        </span>
    </div>

    @if (!Model.Appointments.Any())
    {
        <div class="text-center py-5" style="color:var(--ctxt);">
            <div style="font-size:40px;margin-bottom:8px;">📅</div>
            <div>در این تاریخ نوبتی ثبت نشده</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-accent mb-0">
                <thead>
                    <tr>
                        <th>مشتری</th>
                        <th>خدمت</th>
                        <th>هنرمند</th>
                        <th>ساعت</th>
                        <th>مبلغ</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Appointments.OrderBy(x => x.StartTime))
                    {
                        var statusText = a.Status switch
                        {
                            SmartSalon.Models.AppointmentStatus.Pending => "در انتظار",
                            SmartSalon.Models.AppointmentStatus.Confirmed => "تایید شده",
                            SmartSalon.Models.AppointmentStatus.Cancelled => "لغو شده",
                            SmartSalon.Models.AppointmentStatus.Completed => "تمام شده",
                            _ => "نامشخص"
                        };
                        var statusBadge = a.Status switch
                        {
                            SmartSalon.Models.AppointmentStatus.Pending => "bg-warning",
                            SmartSalon.Models.AppointmentStatus.Confirmed => "bg-success",
                            SmartSalon.Models.AppointmentStatus.Cancelled => "bg-danger",
                            SmartSalon.Models.AppointmentStatus.Completed => "bg-secondary",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:30px;height:30px;border-radius:50%;
                                                background:var(--sb3);
                                                display:flex;align-items:center;justify-content:center;
                                                font-size:12px;color:var(--sb2);font-weight:500;
                                                border:0.5px solid var(--sb4);flex-shrink:0;">
                                        @((a.Client?.FirstName ?? "؟")[0])
                                    </div>
                                    <span>@a.Client?.FirstName @a.Client?.LastName</span>
                                </div>
                            </td>
                            <td>@a.Service?.Name</td>
                            <td>@a.Artist?.User?.FirstName @a.Artist?.User?.LastName</td>
                            <td>@a.StartTime.ToString("HH:mm")</td>
                            <td style="font-weight:500;">@a.EstimatedPrice.ToString("N0")</td>
                            <td>
                                <span class="badge @statusBadge">@statusText</span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    @if (a.Status == SmartSalon.Models.AppointmentStatus.Pending)
                                    {
                                        <form method="post" asp-page-handler="Confirm"
                                              asp-route-id="@a.Id" class="d-inline">
                                            <button class="btn btn-sm"
                                                    style="background:#F0FDF4;border:0.5px solid #BBF7D0;
                                                           color:#16A34A;font-size:11px;">
                                                تایید
                                            </button>
                                        </form>
                                    }
                                    @if (a.Status == SmartSalon.Models.AppointmentStatus.Confirmed)
                                    {
                                        <form method="post" asp-page-handler="Complete"
                                              asp-route-id="@a.Id" class="d-inline">
                                            <button class="btn btn-sm"
                                                    style="background:var(--sb3);border:0.5px solid var(--sb4);
                                                           color:var(--sb2);font-size:11px;">
                                                تکمیل
                                            </button>
                                        </form>
                                    }
                                    @if (a.Status == SmartSalon.Models.AppointmentStatus.Pending ||
                                   a.Status == SmartSalon.Models.AppointmentStatus.Confirmed)
                                    {
                                        <form method="post" asp-page-handler="Cancel"
                                              asp-route-id="@a.Id" class="d-inline">
                                            <button class="btn btn-sm"
                                                    style="background:#FEF2F2;border:0.5px solid #FECACA;
                                                           color:#DC2626;font-size:11px;">
                                                لغو
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>