@page
@model SmartSalon.Pages.Admin.PackagesModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "پکیج‌های خدمات";
    ViewData["ActivePage"] = "Packages";
}

<div class="topbar d-flex justify-content-between align-items-center">
    <div>
        <div style="font-size:16px;font-weight:500;color:var(--txt);">پکیج‌های خدمات</div>
        <div style="font-size:12px;color:var(--ctxt);margin-top:2px;">
            خرید پکیج = فعال شدن خودکار خدمات در سالن
        </div>
    </div>
    @if (Model.ActiveSubscriptions.Any())
    {
        <span style="font-size:12px;background:var(--sb3);color:var(--sb2);
                     padding:6px 14px;border-radius:20px;border:0.5px solid var(--sb4);">
            @Model.ActiveSubscriptions.Count پکیج فعال
        </span>
    }
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.Message.StartsWith("✅") ? "alert-success" : "alert-warning") mb-4">
        @Model.Message
    </div>
}

<!-- پکیج‌های فعال -->
@if (Model.ActiveSubscriptions.Any())
{
    <div class="mb-4">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
            <span class="table-bar"></span>
            <span style="font-size:14px;font-weight:500;color:var(--txt);">پکیج‌های فعال سالن شما</span>
        </div>
        <div class="row g-3">
            @foreach (var sub in Model.ActiveSubscriptions)
            {
                <div class="col-md-4">
                    <div class="card p-3"
                         style="border:0.5px solid var(--sb4);background:var(--sb3);">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div style="font-weight:500;color:var(--sb2);font-size:13px;">
                                @sub.Package?.Name
                            </div>
                            <span class="badge bg-success">فعال ✅</span>
                        </div>
                        <div style="font-size:11px;color:var(--ctxt);">
                            تا: @sub.EndDate.ToString("yyyy/MM/dd")
                        </div>
                        <div style="font-size:11px;color:var(--ctxt);margin-top:4px;">
                            @sub.Package?.Description
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- همه پکیج‌ها -->
<div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
    <span class="table-bar"></span>
    <span style="font-size:14px;font-weight:500;color:var(--txt);">همه پکیج‌ها</span>
</div>

<div class="row g-4">
    @foreach (var pkg in Model.Packages)
    {
        var isActive = Model.ActiveSubscriptions.Any(s => s.PackageId == pkg.Id);
        <div class="col-md-4">
            <div class="card p-4 h-100"
                 style="@(isActive ? "border:0.5px solid var(--sb4);" : "")">

                <!-- هدر پکیج -->
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div style="font-size:15px;font-weight:500;color:var(--txt);">
                            @pkg.Name
                        </div>
                        <div style="font-size:11px;color:var(--ctxt);margin-top:3px;">
                            @pkg.Category
                        </div>
                    </div>
                    @if (isActive)
                    {
                        <span class="badge bg-success">فعال ✅</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">غیرفعال</span>
                    }
                </div>

                <!-- توضیحات -->
                <p style="font-size:12px;color:var(--ctxt);min-height:40px;">
                    @pkg.Description
                </p>

                <!-- قیمت و مدت -->
                <div class="d-flex justify-content-between align-items-center mb-3"
                     style="padding:10px;background:var(--mg);border-radius:8px;">
                    <div>
                        <div style="font-size:11px;color:var(--ctxt);">قیمت</div>
                        <div style="font-size:18px;font-weight:500;color:var(--acc);">
                            @pkg.Price.ToString("N0")
                            <span style="font-size:11px;color:var(--ctxt);font-weight:400;">تومان</span>
                        </div>
                    </div>
                    <div style="text-align:left;">
                        <div style="font-size:11px;color:var(--ctxt);">مدت</div>
                        <div style="font-size:14px;font-weight:500;color:var(--txt);">
                            @pkg.DurationMonths ماه
                        </div>
                    </div>
                </div>

                <!-- دکمه -->
                <div class="mt-auto">
                    @if (!isActive)
                    {
                        <form method="post" asp-page-handler="Buy" asp-route-id="@pkg.Id">
                            <button type="submit" class="btn btn-primary w-100"
                                    style="font-size:13px;">
                                🛒 خرید پکیج
                            </button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Renew" asp-route-id="@pkg.Id">
                            <button type="submit" class="btn btn-sm w-100"
                                    style="background:var(--sb3);border:0.5px solid var(--sb4);
                                           color:var(--sb2);font-size:13px;">
                                🔄 تمدید پکیج
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>