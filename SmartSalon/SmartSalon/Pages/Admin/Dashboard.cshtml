@page
@model SmartSalon.Pages.Admin.DashboardModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "داشبورد";
    ViewData["ActivePage"] = "Dashboard";
}

<div class="topbar">
    <div>
        <div style="font-size:1.1rem;font-weight:700;color:var(--text-primary);">داشبورد مدیریت</div>
        <div style="font-size:0.8rem;color:var(--text-secondary);margin-top:2px;">
            خوش آمدید، <span style="color:var(--primary);font-weight:600;">@Model.AdminName</span>
        </div>
    </div>
    <a href="/Admin/Appointments" class="btn btn-primary btn-sm" style="border-radius:var(--radius-sm);">
        ＋ مشاهده نوبت‌ها
    </a>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="stat-lbl">نوبت‌های امروز</div>
                <div class="stat-icon" style="background:var(--primary-50);">📅</div>
            </div>
            <div class="stat-num" style="color:var(--primary);">@Model.TodayCount</div>
            <div style="font-size:0.7rem;color:var(--text-muted);margin-top:4px;">کل نوبت‌های امروز</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="stat-lbl">در انتظار تایید</div>
                <div class="stat-icon" style="background:var(--warning-50);">⏳</div>
            </div>
            <div class="stat-num" style="color:var(--warning);">@Model.PendingCount</div>
            <div style="font-size:0.7rem;color:#EA580C;margin-top:4px;">نیاز به بررسی</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="stat-lbl">تایید شده</div>
                <div class="stat-icon" style="background:var(--success-50);">✅</div>
            </div>
            <div class="stat-num" style="color:var(--success);">@Model.ConfirmedCount</div>
            <div style="font-size:0.7rem;color:var(--success);margin-top:4px;">
                @(Model.TodayCount > 0 ? $"{Model.ConfirmedCount * 100 / Model.TodayCount}٪ از کل" : "---")
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card-dark">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="stat-lbl">درآمد امروز</div>
                <div class="stat-icon" style="background:rgba(255,255,255,0.15);">💰</div>
            </div>
            <div class="stat-num">@Model.TodayRevenue.ToString("N0")</div>
            <div style="font-size:0.7rem;color:rgba(255,255,255,0.5);margin-top:4px;">تومان</div>
        </div>
    </div>
</div>

<!-- Today's Appointments Table -->
<div class="card">
    <div class="p-3 d-flex justify-content-between align-items-center"
         style="border-bottom:1px solid var(--border-light);">
        <div class="section-header" style="margin-bottom:0;">
            <span class="table-bar"></span>
            <span class="section-header-label">نوبت‌های امروز</span>
        </div>
        <span class="section-header-badge">
            @Model.TodayCount نوبت
        </span>
    </div>

    @if (!Model.TodayAppointments.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">📅</div>
            <div class="empty-state-title">امروز نوبتی ثبت نشده</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-accent mb-0">
                <thead>
                    <tr>
                        <th>مشتری</th>
                        <th>خدمت</th>
                        <th>هنرمند</th>
                        <th>ساعت</th>
                        <th>مبلغ</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.TodayAppointments)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:32px;height:32px;border-radius:50%;
                                                background:var(--primary-100);
                                                display:flex;align-items:center;justify-content:center;
                                                font-size:12px;color:var(--primary);font-weight:600;
                                                flex-shrink:0;">
                                        @(a.ClientName.Length > 0 ? a.ClientName[0].ToString() : "؟")
                                    </div>
                                    <span style="font-weight:500;">@a.ClientName</span>
                                </div>
                            </td>
                            <td>@a.ServiceName</td>
                            <td>@a.ArtistName</td>
                            <td style="font-weight:500;">@a.StartTime.ToString("HH:mm")</td>
                            <td style="font-weight:600;color:var(--text-primary);">
                                @a.EstimatedPrice.ToString("N0")
                            </td>
                            <td>
                                <span class="badge @a.StatusBadge">@a.StatusText</span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    @if (a.Status == 1)
                                    {
                                        <form method="post" asp-page-handler="Confirm"
                                              asp-route-id="@a.Id" class="d-inline">
                                            <button class="btn-action btn-action-approve">تایید</button>
                                        </form>
                                        <form method="post" asp-page-handler="Cancel"
                                              asp-route-id="@a.Id" class="d-inline">
                                            <button class="btn-action btn-action-danger">لغو</button>
                                        </form>
                                    }
                                    @if (a.Status == 2)
                                    {
                                        <form method="post" asp-page-handler="Cancel"
                                              asp-route-id="@a.Id" class="d-inline">
                                            <button class="btn-action btn-action-danger">لغو</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
