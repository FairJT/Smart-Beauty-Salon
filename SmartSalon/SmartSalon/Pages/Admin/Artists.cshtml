@page
@model SmartSalon.Pages.Admin.ArtistsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "پرسنل";
    ViewData["ActivePage"] = "Artists";
}

<div class="topbar d-flex justify-content-between align-items-center">
    <div>
        <div style="font-size:1.1rem;font-weight:700;color:var(--text-primary);">مدیریت پرسنل</div>
        <div style="font-size:0.8rem;color:var(--text-secondary);margin-top:2px;">
            @Model.Artists.Count نفر پرسنل
        </div>
    </div>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addModal">
        ＋ افزودن پرسنل
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.Message.StartsWith("✅") ? "alert-success" : "alert-warning") mb-4">
        @Model.Message
    </div>
}

@if (!Model.Artists.Any())
{
    <div class="card p-5">
        <div class="empty-state">
            <div class="empty-state-icon">👤</div>
            <div class="empty-state-title">هنوز پرسنلی اضافه نشده</div>
            <div class="empty-state-desc">برای افزودن پرسنل روی دکمه بالا کلیک کنید</div>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var a in Model.Artists)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(a.PhotoUrl))
                        {
                            <img src="@a.PhotoUrl" width="52" height="52"
                                 style="border-radius:50%;object-fit:cover;
                                        border:2px solid var(--primary-200);flex-shrink:0;" />
                        }
                        else
                        {
                            <div class="artist-avatar" style="width:52px;height:52px;font-size:20px;">
                                @(a.User?.FirstName?.Length > 0 ? a.User.FirstName[0].ToString() : "؟")
                            </div>
                        }
                        <div style="flex:1;min-width:0;">
                            <div style="font-weight:600;color:var(--text-primary);font-size:0.9rem;">
                                @a.User?.FirstName @a.User?.LastName
                            </div>
                            <div style="font-size:0.75rem;color:var(--text-secondary);margin-top:2px;">
                                @a.BioShort
                            </div>
                        </div>
                        <span class="badge @(a.IsActive ? "bg-success" : "bg-danger")">
                            @(a.IsActive ? "فعال" : "غیرفعال")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3"
                         style="padding:10px;background:var(--primary-50);border-radius:var(--radius-sm);">
                        <div style="text-align:center;">
                            <div style="font-size:0.7rem;color:var(--text-secondary);">نوع قرارداد</div>
                            <div style="font-size:0.8rem;font-weight:600;color:var(--text-primary);margin-top:2px;">
                                @(a.ContractType switch
                                {
                                    SmartSalon.Models.ContractType.FixedSalary => "حقوق ثابت",
                                    SmartSalon.Models.ContractType.LineRent => "اجاره لاین",
                                    SmartSalon.Models.ContractType.RoomRent => "اجاره اتاق",
                                    _ => "نامشخص"
                                })
                            </div>
                        </div>
                        <div style="text-align:center;">
                            <div style="font-size:0.7rem;color:var(--text-secondary);">امتیاز</div>
                            <div style="font-size:0.8rem;font-weight:600;color:#F59E0B;margin-top:2px;">
                                ⭐ @a.RatingAvg.ToString("F1")
                                <span style="color:var(--text-muted);font-weight:400;">(@a.RatingCount)</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <form method="post" asp-page-handler="Toggle"
                              asp-route-id="@a.Id" class="flex-fill">
                            <button class="btn-action w-100"
                                    style="@(a.IsActive ? "background:var(--danger-50);border-color:rgba(239,68,68,0.2);color:#DC2626;" : "background:var(--success-50);border-color:rgba(16,185,129,0.2);color:#059669;")">
                                @(a.IsActive ? "غیرفعال کن" : "فعال کن")
                            </button>
                        </form>
                        <button class="btn-action btn-action-accent"
                                data-bs-toggle="modal"
                                data-bs-target="#photoModal"
                                data-artist-id="@a.Id"
                                data-artist-name="@a.User?.FirstName @a.User?.LastName">
                            📷
                        </button>
                        <a href="/Admin/ArtistReport/@a.Id"
                           class="btn-action btn-action-approve">
                            📊
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Add Artist Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">افزودن پرسنل جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Add">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">شماره موبایل کاربر</label>
                        <input type="text" name="Mobile" class="form-control"
                               placeholder="09121234567" required />
                        <small style="color:var(--text-muted);">کاربر باید قبلاً در سیستم ثبت‌نام کرده باشد</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">بیوگرافی کوتاه</label>
                        <input type="text" name="BioShort" class="form-control"
                               placeholder="متخصص رنگ و هایلایت" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">نوع قرارداد</label>
                        <select name="ContractType" class="form-select">
                            <option value="1">حقوق ثابت</option>
                            <option value="2">اجاره لاین</option>
                            <option value="3">اجاره اتاق</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm"
                            data-bs-dismiss="modal">
                        انصراف
                    </button>
                    <button type="submit" class="btn btn-primary btn-sm">افزودن</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Photo Upload Modal -->
<div class="modal fade" id="photoModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">آپلود عکس پروفایل</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="artistNameLabel" class="mb-3"
                   style="color:var(--text-secondary);font-size:0.85rem;"></p>
                <div class="mb-3">
                    <label class="form-label">انتخاب عکس (JPG، PNG — حداکثر ۵ مگابایت)</label>
                    <input type="file" id="photoFile" class="form-control"
                           accept="image/jpeg,image/png,image/webp" />
                </div>
                <div id="photoPreview" class="text-center mb-3" style="display:none;">
                    <img id="previewImg" src="" width="100" height="100"
                         style="border-radius:50%;object-fit:cover;
                                border:3px solid var(--primary-200);" />
                </div>
                <div id="uploadMessage"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    انصراف
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        onclick="uploadPhoto()">
                    آپلود عکس
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentArtistId = null;

        document.getElementById('photoModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            currentArtistId = btn.dataset.artistId;
            document.getElementById('artistNameLabel').textContent = 'هنرمند: ' + btn.dataset.artistName;
            document.getElementById('photoPreview').style.display = 'none';
            document.getElementById('uploadMessage').innerHTML = '';
            document.getElementById('photoFile').value = '';
        });

        document.getElementById('photoFile').addEventListener('change', function() {
            const file = this.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('previewImg').src = e.target.result;
                document.getElementById('photoPreview').style.display = 'block';
            };
            reader.readAsDataURL(file);
        });

        async function uploadPhoto() {
            const file = document.getElementById('photoFile').files[0];
            if (!file) { alert('لطفاً یک عکس انتخاب کنید'); return; }
            const formData = new FormData();
            formData.append('file', file);
            const msgDiv = document.getElementById('uploadMessage');
            msgDiv.innerHTML = '<div class="alert alert-info">در حال آپلود...</div>';
            try {
                const res = await fetch(`/api/artists/${currentArtistId}/photo`, {
                    method: 'POST', body: formData
                });
                const data = await res.json();
                if (res.ok) {
                    msgDiv.innerHTML = '<div class="alert alert-success">عکس با موفقیت آپلود شد</div>';
                    setTimeout(() => location.reload(), 1500);
                } else {
                    msgDiv.innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
                }
            } catch(e) {
                msgDiv.innerHTML = '<div class="alert alert-danger">خطا در آپلود</div>';
            }
        }
    </script>
}
