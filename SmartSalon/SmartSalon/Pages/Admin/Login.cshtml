@page
@model SmartSalon.Pages.Admin.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ورود مدیر | سالن هوشمند</title>
    <link href="~/lib/bootstrap/bootstrap.rtl.min.css" rel="stylesheet">
    <style>
        body {
            background: #1B3A5C;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .card {
            border-radius: 16px;
            border: none;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }

        .btn-gold {
            background: #9A6F0A;
            color: white;
            border: none;
        }

            .btn-gold:hover {
                background: #7D5A08;
                color: white;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card p-4">
                    <div class="text-center mb-4">
                        <span style="font-size:50px">✂</span>
                        <h4 class="mt-2">پنل مدیریت سالن هوشمند</h4>
                        <p class="text-muted">با حساب مدیر وارد شوید</p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }

                    <form method="post" asp-antiforgery="true">
                        <div class="mb-3">
                            <label class="form-label">شماره موبایل</label>
                            <input type="text" name="Mobile" class="form-control"
                                   placeholder="09121234567" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">رمز عبور</label>
                            <input type="password" name="Password" class="form-control"
                                   placeholder="رمز عبور" required />
                        </div>
                        <button type="submit" class="btn btn-gold w-100 py-2">
                            ورود به پنل مدیریت
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>